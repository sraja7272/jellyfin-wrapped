# Backend environment variables

# Required: Your Jellyfin server URL (can be internal LAN IP)
JELLYFIN_SERVER_URL=http://your-jellyfin-server:8096

# Optional: Public Jellyfin URL used by browsers to fetch poster/actor images
# (defaults to JELLYFIN_SERVER_URL if omitted)
# JELLYFIN_PUBLIC_URL=https://watch.yourdomain.com

# Required: Admin API key from Jellyfin Dashboard > API Keys
JELLYFIN_API_KEY=your-admin-api-key

# Required: Secret for signing JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret

# Optional: Server port (default: 3001)
# PORT=3001

# Optional: Server host (default: 0.0.0.0)
# HOST=0.0.0.0

# Recommended: comma-separated list of frontend origins allowed by CORS ("*" = any).
# If neither CORS_ORIGINS nor FRONTEND_URL is set, all origins are allowed.
# CORS_ORIGINS=http://localhost:5173,https://wrapped.example.com

# Optional: OIDC/SSO Authentication
# Set ALL four OIDC_* variables to enable OIDC login (disables password login when set)
# OIDC_ISSUER_URL=https://your-oidc-provider.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:3001/auth/oidc/callback
# Optional: frontend URL for the post-login redirect (also allowed by CORS)
# FRONTEND_URL=http://localhost
# Optional: Which OIDC claim to use for Jellyfin username matching (default: preferred_username)
# OIDC_USERNAME_CLAIM=preferred_username
